# ============================================
# ARTI 2026 - Muhit Deyishenleri
# Bu faylni .env olaraq kopyalayin ve deyerleri doldurun
# ============================================

# ---- Umumi ----
APP_NAME=ARTI_2026
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-here
APP_URL=http://localhost:8000

# ---- Verilener Bazasi (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arti_2026
DB_USER=arti_admin
DB_PASSWORD=your-db-password-here
DB_SSL_MODE=prefer

# ---- Redis (Kesh ve Session) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0

# ---- MongoDB (Sual Bazasi ve Kontent) ----
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=arti_content
MONGO_USER=arti_mongo
MONGO_PASSWORD=your-mongo-password-here

# ---- AI Agent ----
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
AGENT_MODEL=claude-sonnet-4-5-20250929
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=4096
AGENT_MEMORY_ENABLED=true

# ---- Email Xidmeti ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@arti.edu.az
SMTP_PASSWORD=your-smtp-password-here
SMTP_FROM=ARTI <noreply@arti.edu.az>

# ---- Fayl Saxlama ----
STORAGE_TYPE=local
STORAGE_PATH=/data/storage
MAX_UPLOAD_SIZE=50MB

# ---- JWT Autentifikasiya ----
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# ---- Server (Perspektiv) ----
SERVER_DOMAIN=arti.edu.az
SERVER_IP=0.0.0.0
SSL_CERT_PATH=/etc/ssl/certs/arti.crt
SSL_KEY_PATH=/etc/ssl/private/arti.key

# ---- Monitorinq ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

# ---- Ehtiyat Nusxe ----
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=arti-backups

# ---- CAT/MST Sistemi ----
CAT_MIN_ITEMS=10
CAT_MAX_ITEMS=40
CAT_STOP_SE=0.3
MST_PANELS=3
MST_MODULES_PER_STAGE=3

# ---- Imtahan Platformasi ----
EXAM_MAX_CONCURRENT=500
EXAM_SESSION_TIMEOUT=7200
EXAM_AUTO_SUBMIT=true
